DATABASE_URL=postgresql://localhost:5432/rag_codebase

# LLM for answer synthesis — optional; without any key the API returns
# retrieved chunks with citations, just no synthesized prose answer.
# Provide either (or both — Anthropic wins unless LLM_PROVIDER=groq):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=

# Embeddings — "local" (sentence-transformers, no key, default) or "gemini"
# (hosted, no torch, for tiny free hosting tiers). EMBEDDING_DIM must match:
# local=384, gemini=768 (defaults are set automatically per provider).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIM=  # only set to override the per-provider default
